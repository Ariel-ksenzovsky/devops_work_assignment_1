# Use the official Jenkins LTS image (Debian-based)
FROM jenkins/jenkins:lts

# Switch to root to install Docker
USER root

# Install Docker CLI + Compose plugin from Docker's official repo
RUN apt-get update && \
    apt-get install -y ca-certificates curl gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y docker-ce-cli docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*

# Optional: allow Jenkins user to use Docker without sudo
RUN groupadd -for docker && usermod -aG docker jenkins

# Switch back to Jenkins user
USER jenkins
